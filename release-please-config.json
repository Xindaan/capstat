{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "capstat",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        "packages/capstat-core/pyproject.toml",
        "packages/capstat-core/src/capstat_core/__init__.py",
        "apps/api/pyproject.toml",
        "apps/api/src/capstat_api/__init__.py",
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/api/openapi.json",
          "jsonpath": "$.info.version"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "section": "Tests" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "ci", "section": "Build and CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ]
}
